# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Large Datasets & Archives (GitHub 100MB file limit)
*.csv
*.tsv
*.pcap
*.pcap_ISCX
*.rar
*.zip
*.tar.gz
